rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same admin email restriction as Firestore rules.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "saadmazaa@gmail.com";
    }

    // Blog media: images only, at most 15 MB each.
    match /blog/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
      allow delete: if isAdmin();
    }

    // Downloadable article files (attachment blocks): PDF, Markdown, text,
    // CSV and ZIP only, at most 25 MB. Name and content type must agree, so
    // nothing executable or renderable as a page (HTML, SVG) can be uploaded.
    match /blog/attachments/{file} {
      allow write: if isAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && file.matches('[a-z0-9-]+[.](pdf|md|txt|csv|zip)')
                   && request.resource.contentType.matches('application/pdf|text/markdown|text/plain|text/csv|application/zip');
    }

    // Everything else: anyone can read public assets (logos, certificates,
    // images); only the admin can upload or delete. Rules OR together, so the
    // blog folder is excluded here or its restrictions above would be bypassed.
    match /{folder}/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin() && folder != 'blog';
    }
  }
}
