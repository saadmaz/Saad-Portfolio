rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same admin email restriction as Firestore rules.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "saadmazaa@gmail.com";
    }

    // Blog media: images only, at most 15 MB each.
    match /blog/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
      allow delete: if isAdmin();
    }

    // Everything else: anyone can read public assets (logos, certificates,
    // images); only the admin can upload or delete. Rules OR together, so the
    // blog folder is excluded here or its restrictions above would be bypassed.
    match /{folder}/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin() && folder != 'blog';
    }
  }
}
