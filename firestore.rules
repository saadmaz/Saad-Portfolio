rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Public portfolio data - anyone reads, admin writes
    match /projects/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /experience/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /skills/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /certificates/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /awards/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /newsletters/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /languages/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /hackathons/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /education/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /volunteer/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /profile/{id}       { allow read: if true; allow write: if isAdmin(); }

    // Contact form - anyone can submit, only admin can read/delete
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin-only
    match /activity_logs/{id}  { allow read, write: if isAdmin(); }
    match /activity-logs/{id}  { allow read, write: if isAdmin(); }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
