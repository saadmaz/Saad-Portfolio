rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only this account may write portfolio data (used by the admin app).
    // Never relax this to "request.auth != null" - that lets ANY signed-in
    // Firebase user write to the database.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "saadmazaa@gmail.com";
    }

    // ── Public portfolio data — anyone reads, only admin writes ──────
    match /projects/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /work_experience/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /skills/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /certificates/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /awards/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /newsletters/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /languages/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /hackathons/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /education/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /volunteer_experience/{id} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /publications/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /patents/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /test_scores/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /organizations/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /causes/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /hosting/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /site_settings/{id}        { allow read: if true; allow write: if isAdmin(); }

    // ── Blog / editorial CMS ─────────────────────────────────────────
    // Drafts, scheduled and archived posts are private: the public can only
    // read live posts, so every public query must filter published == true.
    match /blog_posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
      // Revision history (CMS only).
      match /revisions/{revisionId} { allow read, write: if isAdmin(); }
    }
    // Unpublished edits to live posts, waiting for "Update".
    match /blog_autosaves/{id}  { allow read, write: if isAdmin(); }
    match /authors/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /blog_series/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /blog_settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    // Public so the site can honour redirects created since the last build.
    match /redirects/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /media/{id}           { allow read, write: if isAdmin(); }

    // Written ONLY by the Vercel functions (Admin SDK bypasses rules).
    match /blog_reactions/{id}  { allow read: if true; allow write: if false; }
    match /reaction_votes/{id}  { allow read, write: if false; }
    match /blog_stats/{id=**}   { allow read: if isAdmin(); allow write: if false; }
    match /not_found/{id}       { allow read, delete: if isAdmin(); allow create, update: if false; }
    match /system/{id}          { allow read: if isAdmin(); allow write: if false; }

    // ── Contact form — written ONLY by /api/contact ─────────────────
    // The Admin SDK bypasses these rules; the API validates and
    // rate-limits. Clients can't create, so the collection can't be
    // spammed directly.
    match /contact_messages/{id} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── Admin-only internal collections ──────────────────────────────
    match /activity_logs/{id} { allow read, write: if isAdmin(); }

    // ── Deny everything else ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
