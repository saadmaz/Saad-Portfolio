rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT: Replace the placeholder below with the email address you use
    // to log in at /admin/dashboard (the one you entered in Firebase Auth).
    // Keeping this as "request.auth != null" allows ANY authenticated Firebase
    // user to write to your database — that is a security hole.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "YOUR_ADMIN_EMAIL_HERE";
    }

    // ── Public portfolio data — anyone reads, only admin writes ──────
    match /projects/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /blog_posts/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /work_experience/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /skills/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /certificates/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /awards/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /newsletters/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /languages/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /hackathons/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /education/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /volunteer_experience/{id} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /publications/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /patents/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /test_scores/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /organizations/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /causes/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /hosting/{id}              { allow read: if true; allow write: if isAdmin(); }

    // ── Contact form — anyone can submit, only admin can read/delete ─
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Admin-only internal collections ──────────────────────────────
    match /activity_logs/{id} { allow read, write: if isAdmin(); }

    // ── Deny everything else ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
