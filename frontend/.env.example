# Copy this file to .env and fill in your values. Never commit .env.

# ─── Browser (Vite) ─────────────────────────────────────────────
# Firebase web config: public identifiers, shipped in the bundle.
# Security is enforced by firestore.rules / storage.rules.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Server only (server/*, scripts/prerender.mjs) ────────────
# Set these in Cloudflare Pages → Settings → Variables and secrets. NEVER prefix with VITE_.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RESEND_API_KEY=re_xxx
TO_EMAIL=you@example.com
FROM_EMAIL=noreply@example.com

# ─── Editorial CMS (server only - Cloudflare Pages secrets, never VITE_) ──
# The one account allowed to call /api/admin (same as isAdmin() in firestore.rules).
ADMIN_EMAIL=you@example.com
# Origins allowed to call /api/admin from the browser (the CMS), comma-separated.
ADMIN_ORIGINS=https://admin.saadmaz.com
# Signs short-lived draft-preview links. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PREVIEW_SECRET=
# Authorises /api/cron/publish-scheduled (called by the GitHub workflow, which
# needs the same value as a repository secret). 16+ chars.
CRON_SECRET=
# Cloudflare → Workers & Pages → project → Settings → Builds → Deploy hooks. Lets publishing refresh
# prerendered pages and share cards. Optional; without it they refresh on the next deploy.
DEPLOY_HOOK_URL=
# Keys the daily-rotating visitor hash for analytics and reaction de-duplication. 16+ chars.
ANALYTICS_SALT=
# Optional separate key for reactions (defaults to ANALYTICS_SALT).
REACTIONS_SALT=
# Signs newsletter confirm/unsubscribe links. 32+ chars (falls back to PREVIEW_SECRET).
SUBSCRIBE_SECRET=
# Optional: override the public URL used in preview links (e.g. a preview deployment).
PUBLIC_SITE_URL=

# ─── Optional reporting integrations (status shown in the CMS; not yet fetched) ──
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_EMAIL=
