# Copy this file to .env and fill in your values. Never commit .env.

# ─── Browser (Vite) ─────────────────────────────────────────────
# Firebase web config: public identifiers, shipped in the bundle.
# Security is enforced by firestore.rules / storage.rules.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Server only (api/contact.ts, scripts/prerender.mjs) ────────
# Set these in the Vercel dashboard. NEVER prefix with VITE_.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SENDGRID_API_KEY=SG.xxx
TO_EMAIL=you@example.com
FROM_EMAIL=noreply@example.com
