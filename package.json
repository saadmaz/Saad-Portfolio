{
  "name": "portfolio-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "frontend:dev": "bun --cwd frontend run dev",
    "backend:dev": "bun --cwd backend run dev",
    "dev": "concurrently \"bun frontend:dev\" \"bun backend:dev\"",
    "build": "bun --cwd frontend run build && bun --cwd backend run build",
    "lint": "bun --cwd frontend run lint && bun --cwd backend run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
