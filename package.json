{
  "name": "portfolio-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "backend:dev": "npm --prefix backend run dev",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.24.0",
    "@swc/core-linux-x64-gnu": "1.13.2",
    "@swc/core-linux-x64-musl": "1.13.2",
    "@swc/core-linux-arm64-gnu": "1.13.2",
    "@esbuild/linux-x64": "0.21.5",
    "@esbuild/linux-arm64": "0.21.5"
  },
  "engines": {
    "node": "20.x"
  }
}
