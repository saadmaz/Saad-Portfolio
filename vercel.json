{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "backend/src/server.ts" },
    { "source": "/health", "destination": "backend/src/server.ts" },
    { "source": "/(admin|projects|blog|experience|skills|certifications|about|contact|newsletters|events)(.*)", "destination": "/index.html" },
    { "source": "/((?!api/|favicon.ico|logo.png|profile-photo.png|robots.txt).*)", "destination": "/index.html" }
  ]
}