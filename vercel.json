{
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/admin/:match*", "destination": "/api/admin/:match*" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ]
}